# Copy to .env in the repository root ONLY if it does not exist. Never commit .env.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_random_hex_characters

# Local PostgreSQL (Docker Compose). Replace the password in BOTH places.
# Use a hexadecimal password to avoid URL-encoding special characters.
POSTGRES_USER=devflow
POSTGRES_DB=devflow
POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgresql://devflow:replace_with_a_local_password@127.0.0.1:5432/devflow?schema=public

# LOCAL: DIRECT_URL is optional. Leave it unset (CLI uses DATABASE_URL),
# or set it to the same local Docker URL. Do not put a production URL in your local .env.

# PRODUCTION: configure these separately in the hosting/CI secret manager.
# Placeholders only; use the exact pooler host and user from Supabase Connect.
# DATABASE_URL: Supabase transaction pooler (runtime, port 6543).
# DATABASE_URL=postgresql://<DB_USER>.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<POOLER_HOST>:6543/postgres?schema=public&sslmode=require
# DIRECT_URL: Supabase session pooler (Prisma CLI/migrations, port 5432).
# DIRECT_URL=postgresql://<DB_USER>.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<POOLER_HOST>:5432/postgres?schema=public&sslmode=require
